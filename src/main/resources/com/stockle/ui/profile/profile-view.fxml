<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.image.*?>
<?import javafx.geometry.Insets?>

<BorderPane xmlns:fx="http://javafx.com/fxml"
            xmlns="http://javafx.com/javafx"
            fx:controller="com.stockle.ui.ProfileController"
            stylesheets="@profile.css">

    <!-- Sidebar -->
    <left>
        <VBox styleClass="sidebar">
            <padding><Insets top="24" bottom="16" left="16" right="16"/></padding>
            <Label text="Stockle" styleClass="sidebar-logo"/>
            <VBox spacing="2" styleClass="nav-section">
                <Button text="Dashboard" maxWidth="Infinity" styleClass="nav-item" onAction="#handleBack"/>
                <Button text="Trading"   maxWidth="Infinity" styleClass="nav-item" onAction="#navTrading"/>
                <Button text="AI Chat"   maxWidth="Infinity" styleClass="nav-item" onAction="#navAI"/>
                <Button text="News"      maxWidth="Infinity" styleClass="nav-item" onAction="#navNews"/>
                <Button text="Profile"   maxWidth="Infinity" styleClass="nav-item-active"/>
            </VBox>
            <Region VBox.vgrow="ALWAYS"/>
            <Button fx:id="darkModeBtn" mnemonicParsing="false" onAction="#toggleDarkMode" styleClass="dark-mode-btn">
                <graphic>
                    <ImageView fx:id="darkModeIcon" fitHeight="14.0" fitWidth="14.0" pickOnBounds="true" preserveRatio="true">
                        <image><Image url="@../images/dark-mode-button.png"/></image>
                    </ImageView>
                </graphic>
            </Button>
            <Button text="Sign Out" maxWidth="Infinity" styleClass="nav-signout" onAction="#handleSignOut"/>
        </VBox>
    </left>

    <!-- Main content -->
    <center>
        <ScrollPane fitToWidth="true" styleClass="main-scroll" hbarPolicy="NEVER">
            <VBox spacing="24" styleClass="main-content">
                <padding><Insets top="28" bottom="36" left="28" right="28"/></padding>

                <!-- Header -->
                <VBox spacing="2">
                    <Label text="Profile" styleClass="page-title"/>
                    <Label text="Manage your account settings." styleClass="page-subtitle"/>
                </VBox>

                <!-- Form card -->
                <VBox styleClass="card" maxWidth="560">
                    <padding><Insets top="24" bottom="24" left="24" right="24"/></padding>
                    <VBox spacing="18">

                        <!-- Username -->
                        <VBox spacing="6">
                            <Label text="Username" styleClass="field-label"/>
                            <TextField fx:id="usernameField" promptText="Username" styleClass="profile-input"/>
                        </VBox>

                        <!-- Email -->
                        <VBox spacing="6">
                            <Label text="Email" styleClass="field-label"/>
                            <TextField fx:id="emailField" promptText="Email" styleClass="profile-input"/>
                        </VBox>

                        <!-- Divider -->
                        <Region styleClass="profile-divider" prefHeight="1" maxWidth="Infinity"/>

                        <!-- New Password -->
                        <VBox spacing="6">
                            <Label text="New Password" styleClass="field-label"/>
                            <PasswordField fx:id="newPasswordField"
                                          promptText="Leave blank to keep current password"
                                          styleClass="profile-input"/>
                        </VBox>

                        <!-- Confirm Password -->
                        <VBox spacing="6">
                            <Label text="Confirm New Password" styleClass="field-label"/>
                            <PasswordField fx:id="confirmPasswordField"
                                          promptText="Confirm new password"
                                          styleClass="profile-input"/>
                        </VBox>

                        <!-- Feedback -->
                        <Label fx:id="feedbackLabel" styleClass="feedback-label" wrapText="true"/>

                        <!-- Actions -->
                        <HBox spacing="12">
                            <Button text="Save Changes" styleClass="profile-save-btn" onAction="#handleSave"/>
                            <Button text="Back to Dashboard" styleClass="profile-back-btn" onAction="#handleBack"/>
                        </HBox>

                    </VBox>
                </VBox>

            </VBox>
        </ScrollPane>
    </center>
</BorderPane>
