<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.VBox?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.PasswordField?>
<VBox alignment="CENTER" spacing="12" xmlns:fx="http://javafx.com/fxml"
      fx:controller="com.stockle.ui.LoginController">
    <padding>
        <Insets bottom="40" left="40" right="40" top="40"/>
    </padding>

    <Label text="Stockle" style="-fx-font-size: 28; -fx-font-weight: bold;"/>
    <Label text="Sign in to your account" style="-fx-text-fill: grey;"/>

    <TextField fx:id="usernameField" promptText="Username"/>
    <PasswordField fx:id="passwordField" promptText="Password"/>

    <Label fx:id="errorLabel" style="-fx-text-fill: red;"/>

    <Button text="Sign In" onAction="#onLoginButtonClick"/>
    <Button text="Dont have an account? Sign Up" onAction="#onSignUpLinkClick"
            style="-fx-background-color: transparent; -fx-text-fill: grey;"/>
</VBox>